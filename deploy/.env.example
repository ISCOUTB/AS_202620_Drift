# Copia este archivo como deploy/.env para probar en tu computador.
# deploy/.env no se versiona. Todos los valores son opcionales.

# Origen permitido por CORS en la API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Tasa USD→COP de respaldo si la API de tasa de cambio no responde.
USD_TO_COP_RATE=3250

# SECRETOS. Direcciones privadas (por ejemplo, los enlaces «raw» de un gist
# secreto) de las copias de puntajes generadas con scripts/actualizar_benchmarks.py.
# No escribas aquí los valores reales: van en tu deploy/.env y en el panel del servidor.
DRIFT_GPU_BENCHMARKS_URL=
DRIFT_CPU_BENCHMARKS_URL=

# Integración con Steam (valores por defecto mostrados; ver ADR-0009).
# MAX_ATTEMPTS cuenta intentos totales: 2 = una llamada y un reintento.
# DRIFT_STEAM_TIMEOUT_SECONDS=3.0
# DRIFT_STEAM_MAX_ATTEMPTS=2
# DRIFT_STEAM_BACKOFF_BASE_SECONDS=0.25
# DRIFT_STEAM_BACKOFF_MAX_SECONDS=2.0
# DRIFT_STEAM_MAX_RETRY_AFTER_SECONDS=2.0
# DRIFT_STEAM_TOTAL_DEADLINE_SECONDS=4.0
# DRIFT_CHEAPSHARK_TIMEOUT_SECONDS=3.0
# DRIFT_CHEAPSHARK_TOTAL_DEADLINE_SECONDS=3.0
# DRIFT_EXCHANGE_TIMEOUT_SECONDS=3.0
