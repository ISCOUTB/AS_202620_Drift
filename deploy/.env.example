# Copia este archivo como deploy/.env para probar en tu computador.
# deploy/.env no se versiona. Todos los valores son opcionales.

# Origen permitido por CORS en la API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Tasa USD→COP de respaldo si la API de tasa de cambio no responde.
USD_TO_COP_RATE=3250

# SECRETOS. Direcciones privadas (por ejemplo, los enlaces «raw» de un gist
# secreto) de las copias de puntajes generadas con scripts/actualizar_benchmarks.py.
# No escribas aquí los valores reales: van en tu deploy/.env y en el panel del servidor.
DRIFT_GPU_BENCHMARKS_URL=
DRIFT_CPU_BENCHMARKS_URL=
# Sin estas direcciones ni los archivos locales, la lista de gráficas y
# procesadores queda casi vacía. En tu computador basta con generar los
# archivos: python scripts/actualizar_benchmarks.py
# Con base de datos, los puntajes se guardan en PostgreSQL la primera vez (ADR-0018).

# SECRETO. Token para las operaciones administrativas (sincronizar el catálogo
# de PlayStation y leer /metrics), ver ADR-0011. Genera uno largo y aleatorio,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacío = esas operaciones quedan deshabilitadas.
DRIFT_ADMIN_TOKEN=

# Límite de peticiones por minuto y por cliente en búsqueda y compatibilidad
# (ADR-0012). 0 lo desactiva, por ejemplo para las pruebas de carga con k6.
DRIFT_RATE_LIMIT_PER_MINUTE=60

# Usar la última IP de X-Forwarded-For (solo detrás de un proxy de confianza).
DRIFT_TRUST_FORWARDED_FOR=false

# SECRETO. Contraseña de PostgreSQL (ADR-0014). Obligatoria para levantar
# deploy/compose.lab.yaml. Debe ser segura para una URL; genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DRIFT_DB_PASSWORD=

# Copias de respaldo de las fuentes (ADR-0015).
# FRESH: una copia más nueva se usa sin llamar a la fuente (15 minutos).
# STALE: una copia más vieja ya no se muestra si la fuente falla (72 horas).
DRIFT_CACHE_FRESH_SECONDS=900
DRIFT_CACHE_STALE_SECONDS=259200

# Solo para correr la API fuera de Docker con un PostgreSQL propio. Sin ella,
# las copias de respaldo viven en memoria. El compose la arma por su cuenta.
# DRIFT_DATABASE_URL=postgresql://drift:<contraseña>@localhost:5432/drift

# Integración con Steam (valores por defecto mostrados; ver ADR-0009).
# MAX_ATTEMPTS cuenta intentos totales: 2 = una llamada y un reintento.
# DRIFT_STEAM_TIMEOUT_SECONDS=3.0
# DRIFT_STEAM_MAX_ATTEMPTS=2
# DRIFT_STEAM_BACKOFF_BASE_SECONDS=0.25
# DRIFT_STEAM_BACKOFF_MAX_SECONDS=2.0
# DRIFT_STEAM_MAX_RETRY_AFTER_SECONDS=2.0
# DRIFT_STEAM_TOTAL_DEADLINE_SECONDS=4.0
# DRIFT_CHEAPSHARK_TIMEOUT_SECONDS=3.0
# DRIFT_CHEAPSHARK_TOTAL_DEADLINE_SECONDS=3.0
# DRIFT_EXCHANGE_TIMEOUT_SECONDS=3.0
# DRIFT_XBOX_TIMEOUT_SECONDS=3.0
# DRIFT_XBOX_TOTAL_DEADLINE_SECONDS=3.0

# SECRETO. Llave de IsThereAnyDeal: precios de las tiendas de PC e historial
# de precios. Se obtiene gratis registrando una app (ver la sección «Access»
# de https://docs.isthereanydeal.com/). Vacía = esas tiendas y el historial
# quedan deshabilitados; el resto de DRIFT funciona igual.
DRIFT_ITAD_API_KEY=

# Inicio de sesión con Google. El Client ID es público; el Client Secret es
# SECRETO. Se crean en https://console.cloud.google.com/ (Credenciales → ID de
# cliente de OAuth, tipo «Aplicación web»). Sin ellos el inicio de sesión queda deshabilitado (ADR-0017).
DRIFT_GOOGLE_CLIENT_ID=
DRIFT_GOOGLE_CLIENT_SECRET=

# Dirección a la que Google devuelve a la persona. Debe coincidir, letra por
# letra, con una «URI de redireccionamiento autorizada» del cliente de Google.
# En tu computador: http://localhost:8000/auth/google/callback
# En el laboratorio: https://drift.iscoutb.dev/api/auth/google/callback
# DRIFT_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Página a la que se vuelve después de iniciar sesión.
# DRIFT_FRONTEND_URL=http://localhost:3000
